    <string name="adb_agent_access">允许代理使用 adb</string>
    <string name="adb_agent_access_hint">代理会以这部手机上的 shell 用户身份运行 adb。</string>
    <string name="adb_agent_access_confirm_title">要让代理控制这部手机吗？</string>
    <string name="adb_agent_access_warning">代理将能够安装和卸载应用、授予权限、更改设置、读取系统日志，以及在屏幕上点按或输入。不需要时请关闭此功能。</string>
